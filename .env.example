# Explore Galiyat Server Configuration
NODE_ENV=development
PORT=8080
APP_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080,https://travel-agency-ten-chi.vercel.app

# PostgreSQL Database (Neon Serverless PostgreSQL)
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>/<DB_NAME>?sslmode=require

# Authentication & Security
JWT_SECRET=your-strong-random-jwt-secret-key-min-32-chars
JWT_EXPIRES_IN=24h
COOKIE_NAME=agy_admin_session

# Gmail / Custom SMTP Settings
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password

# Email Sender Info & Admin Notifications
EMAIL_FROM="Explore Galiyat Reservations" <reservations@exploregaliyat.com>
ADMIN_NOTIFICATION_EMAIL=admin@exploregaliyat.com
